# ==============================================================================
# Anonymous Instagram Public Media Viewer — Environment Configuration
# ==============================================================================

# Provider Selection
# Options:
#   - 'scraperapi': ScraperAPI / AnonyIG provider (recommended for live Posts, Stories, Reels, Highlights)
#   - 'direct': Built-in live SSR crawler for public profile info (zero keys needed)
#   - 'rapidapi': RapidAPI scraper provider (e.g. instagram-scraper-api2)
#   - 'demo': Offline testing provider with real playable videos and image carousels
INSTAGRAM_PROVIDER=scraperapi

# ScraperAPI / AnonyIG Configuration (Recommended)
# Sign up at https://scraperapi.to/instagram-scraper or https://anonyig.com/en/api/ (Free 1,000 req/mo, no card required)
SCRAPERAPI_TOKEN=

# RapidAPI Configuration (Alternative)
INSTAGRAM_RAPIDAPI_KEY=
INSTAGRAM_RAPIDAPI_HOST=instagram-scraper-api2.p.rapidapi.com

# In-Memory Cache TTL (seconds)
CACHE_TTL_PROFILE=600       # 10 minutes
CACHE_TTL_POSTS=900         # 15 minutes
CACHE_TTL_REELS=900         # 15 minutes
CACHE_TTL_STORIES=180       # 3 minutes (short-lived, time-sensitive)
CACHE_TTL_HIGHLIGHTS=900    # 15 minutes

# Security & SSRF Configuration
# Additional trusted media domains (comma-separated, without scheme)
ALLOWED_MEDIA_DOMAINS=

# Debug Logging (true/false)
DEBUG=false
